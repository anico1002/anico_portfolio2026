# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.aider*
node_modules/
dist/
build/
*.log
.env
.env.*
.vite/
coverage/

# Capturas nativas de Gloop sin publicar (repo público)
/public/maqueta/gloop/screens/
/public/maqueta/gloop/media/

# Vídeos HyperFrames: se versiona la composición, no la captura ni los renders
/motion/*/capture/
/motion/*/snapshots/
/motion/*/renders/
/motion/*/.hyperframes/
/motion/*/.thumbnails/

# Fotos del universo de marca de Interactius (posible licencia de terceros): solo en local.
/public/maqueta/interactius/media/

# Plantillas de mockups (PSD pesados, licencia de terceros): solo en local
/mockups-src/
/public/maqueta/7news/screens/
/public/maqueta/7news/media/
scripts/mockups/photoshop/run.jsx

# Fuentes de prueba de fundiciones (licencia de evaluación: nunca al repo ni a la web)
/fuentes-prueba/

# Fuentes con licencia (o de prueba) para la web: el repo es público, nunca a git
/public/fonts-licencia/
/public/maqueta/wineup/media/
/scripts/case-media/shots-en/
