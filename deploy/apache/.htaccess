# anico.design — export estático de Next servido por Apache en MindYourGap. anico.es redirige aquí.
# Réplica de las cabeceras que daba Vercel (next.config.ts), más lo que Apache necesita de más: tipos MIME de los
# medios modernos, el dominio único y las redirecciones de URLs viejas y atajos.
# Plantilla: deploy/apache/.htaccess. deploy/build.mjs rellena las redirecciones (@@REDIRECCIONES@@).

Options -Indexes +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Web pública desde el 2026-11-02: se indexa. Solo las tipografías con licencia quedan fuera de buscadores.
  <If "%{REQUEST_URI} =~ m#^/fonts-licencia/#">
    Header set X-Robots-Tag "noindex, nofollow"
  </If>

  # --- Seguridad (igual que en Vercel) ---
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"
  Header set X-Frame-Options "DENY"
  Header set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
  # El prototipo de DesignOps Copilot se navega dentro de la pantalla de su caso (iframe del mismo dominio,
  # 2026-11-01): solo esa carpeta se deja incrustar, y solo desde aquí.
  <If "%{REQUEST_URI} =~ m#^/maqueta/designops/app/#">
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  </If>
  Header unset X-Powered-By
  Header unset Server

  # --- Caché de medios: un día + una semana en segundo plano (sin immutable: nombres sin hash) ---
  <FilesMatch "\.(avif|webp|png|jpg|jpeg|gif|svg|mp4|webm|mov|woff2|woff)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  # Los HTML no se cachean: el contenido cambia y no llevan hash.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Los bundles de Next sí llevan hash en el nombre: inmutables de verdad.
  <FilesMatch "^.*$">
    <If "%{REQUEST_URI} =~ m#^/_next/static/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
</IfModule>

# --- Tipos MIME que Apache viejo puede no servir bien ---
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType video/quicktime .mov
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

RewriteEngine On

# --- Un solo dominio: anico.es y los www llevan a https://anico.design, con la misma ruta (Alberto, 2026-11-02) ---
# Solo esos nombres: el alias del hosting (anico.es.mialias.net) sigue sirviendo la web tal cual, para pruebas.
RewriteCond %{HTTP_HOST} ^(www\.)?anico\.es$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.anico\.design$ [NC]
RewriteRule ^ https://anico.design%{REQUEST_URI} [R=301,L]
# http → https. Comprobar tras publicar que no hace bucle (si el servidor tuviera un proxy delante, %{HTTPS} no
# vería el https: para eso la condición de X-Forwarded-Proto).
RewriteCond %{HTTP_HOST} ^anico\.design$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://anico.design%{REQUEST_URI} [R=301,L]

# --- URLs viejas y atajos (generado por deploy/build.mjs a partir de las páginas del export) ---
# @@REDIRECCIONES@@

# --- 404 propio del export ---
ErrorDocument 404 /404.html
